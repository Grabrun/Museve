{
  "name": "museve",
  "version": "1.0.0",
  "private": true,
  "description": "暮想 Museve — 前端资源构建与本地依赖",
  "scripts": {
    "build:css": "tailwindcss -i resources/css/tailwind.src.css -o resources/css/tailwind.css --minify",
    "build:vendor": "node tools/sync-vendor.mjs",
    "build": "npm run build:css && npm run build:vendor",
    "lint:php": "node tools/lint-php.mjs",
    "check:classes": "node tools/check-classes.mjs",
    "verify": "npm run build && npm run check:classes && npm run lint:php"
  },
  "devDependencies": {
    "@phosphor-icons/web": "2.1.1",
    "alpinejs": "3.14.9",
    "dompurify": "3.2.6",
    "php-parser": "3.2.3",
    "pjax": "0.2.8",
    "tailwindcss": "3.4.17",
    "tinymce": "6.8.5"
  }
}
