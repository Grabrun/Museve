# ============================================================
# Museve .gitignore
# ------------------------------------------------------------
# 原则：凡是"运行时产生""含机密""开发期工具""内部资料"，一律不入库。
# ============================================================

# ---------- 机密 ----------
includes/config.php

# ---------- 运行时数据 ----------
uploads/*
!uploads/.gitkeep
backups/
*.log

# ---------- 内部资料（含漏洞细节 / 工作笔记，不可公开） ----------
.workbuddy/
docs/museve-audit-*.md

# ---------- 开发工具链与构建输入输出 ----------
node_modules/
tools/php/
dist/

# ---------- 环境与编辑器 ----------
.env
.openclaw/
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
